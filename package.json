{
  "name": "technical-debt-scanner",
  "displayName": "technical-debt-scanner",
  "description": "An extension to keep track of technical debt",
  "version": "0.0.1",
  "engines": {
    "vscode": "1.112.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "td-explorer",
          "title": "TD Scanner",
          "icon": "src/icon.svg"
        }
      ]
    },
    "views": {
      "td-explorer": [
        {
          "id": "td-scanner-view",
          "name": "Scanned Results",
          "icon": "src/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "td-scanner.runScan",
        "title": "Run technical debt scanner"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.116.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}